{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .kx/index.db ] || exit 0; exec python3 \"$CLAUDE_PLUGIN_ROOT/skills/productivity/using-featurekit/scripts/kx.py\" hook prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Grep|Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .kx/index.db ] || exit 0; exec python3 \"$CLAUDE_PLUGIN_ROOT/skills/productivity/using-featurekit/scripts/kx.py\" hook tool",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
