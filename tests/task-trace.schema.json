{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featurekit.local/task-trace.schema.json",
  "title": "FeatureKit content-free task trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identity", "input", "calls", "usage", "workflow", "quality", "cost"],
  "properties": {
    "schema": {"const": 1},
    "identity": {"type": "object"},
    "input": {"type": "object"},
    "calls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "workers", "reviewers", "jev"],
      "properties": {
        "primary": {"type": "array"},
        "workers": {"type": "array"},
        "reviewers": {"type": "array"},
        "jev": {"type": "array"}
      }
    },
    "usage": {"type": "object"},
    "workflow": {"type": "object"},
    "quality": {"type": "object"},
    "cost": {"type": "object"}
  }
}
